<Project>
	<PropertyGroup>
		<!-- The .NET the *consumers* of these bindings are expected to run on: it
		     builds the public workload TFM (net10.0-gtk4.22) and the framework the
		     tests, samples and templates are built for. It is deliberately not the
		     framework the wrappers themselves compile against. -->
		<_GtkSharpNetVersion>10.0</_GtkSharpNetVersion>
		<!-- The wrappers are P/Invoke over Gtk and use nothing outside
		     netstandard2.0, so one build of each serves every consumer: .NET 10,
		     .NET Framework 4.x, Mono. Building a second, identical net10.0 copy
		     only doubled the build and put two indistinguishable assemblies in
		     each package. The workload ref/runtime packs harvest this output and
		     ship it under net$(_GtkSharpNetVersion)-gtk4.22, which stays the TFM
		     consumers reference. -->
		<_GtkSharpLibTfm>netstandard2.0</_GtkSharpLibTfm>
		<_GtkSharpSourceDirectory>$(MSBuildThisFileDirectory)</_GtkSharpSourceDirectory>
		<_GtkSharpBuildOutputDirectory>$(MSBuildThisFileDirectory)..\BuildOutput\</_GtkSharpBuildOutputDirectory>
	</PropertyGroup>

	<PropertyGroup>
		<PackageProjectUrl>https://github.com/GtkSharp/GtkSharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/GtkSharp/GtkSharp</RepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>
</Project>