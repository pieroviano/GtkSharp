<Project>
	<PropertyGroup>
		<_GtkSharpNetVersion>10.0</_GtkSharpNetVersion>
		<_GtkSharpSourceDirectory>$(MSBuildThisFileDirectory)</_GtkSharpSourceDirectory>
		<_GtkSharpBuildOutputDirectory>$(MSBuildThisFileDirectory)..\BuildOutput\</_GtkSharpBuildOutputDirectory>
	</PropertyGroup>

	<PropertyGroup>
		<PackageProjectUrl>https://github.com/GtkSharp/GtkSharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/GtkSharp/GtkSharp</RepositoryUrl>
		<MinimalDirectoryNuGetProps>true</MinimalDirectoryNuGetProps>
		<!-- The version the projects' PackageReference and its two Imports both
		     resolve through. It lives here rather than in the Directory.Nuget.Props
		     the utility generates, because that file is gitignored (*.nuget.props),
		     is not a name MSBuild imports on its own, and ends by setting this
		     property unconditionally to a different version. -->
		<NuGetUtilityVersion>1.0.13</NuGetUtilityVersion>

		<!-- The utility does not obfuscate these. They are bindings whose type and
		     member names are the API, and it would only run on a Windows Release
		     build, so it would also make local packages differ from the ones CI
		     publishes. -->
		<DontObfuscate>true</DontObfuscate>
	</PropertyGroup>

	<!-- build.cake owns the version: Init sets 4.22.4.<run number> and passes it
	     as -p:Version. The utility recomputes Version as
	     $(VersionPrefix).$(VersionSuffix) from inside a target, where even a
	     global property loses, so those two have to be able to rebuild it.
	     Splitting the incoming Version on its last dot does that exactly,
	     including the "-develop" build.cake appends off the release branch. -->
	<PropertyGroup>
		<_GtkSharpPackageVersion>$(Version)</_GtkSharpPackageVersion>
		<_GtkSharpPackageVersion Condition="'$(_GtkSharpPackageVersion)' == ''">4.22.4.1</_GtkSharpPackageVersion>
		<VersionPrefix>$(_GtkSharpPackageVersion.Substring(0, $(_GtkSharpPackageVersion.LastIndexOf('.'))))</VersionPrefix>
		<VersionSuffix>$(_GtkSharpPackageVersion.Substring($([MSBuild]::Add($(_GtkSharpPackageVersion.LastIndexOf('.')), 1))))</VersionSuffix>
	</PropertyGroup>
</Project>